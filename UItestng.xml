<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="OrangeHRM Suite"
       parallel="methods"
       thread-count="2"
       data-provider-thread-count="2">

    <listeners>
        <listener class-name="listeners.ExtentTestListener"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="tests.UI.LoginTest"/>
             <class name="tests.UI.VerifyTimeAtWorkTest"/>
        </classes>
    </test>

</suite>
